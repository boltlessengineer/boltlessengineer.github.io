@eval
# add custom tag while exporting document
(put norg/ast/tag
     "\\gh"
     (fn [ctx [src] markup]
       [{:kind :link
         :target (string "https://github.com/" src)
         :markup [{:kind :text
                   :text src}]}]))
@end

- {https://github.com/boltlessengineer}[link with /markups/](html.class my-class)
- [anchor]{https://example.com} : `[anchor]{https://example.com}`
- can be used again like this: [anchor]

